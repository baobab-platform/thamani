{
  "name": "Thamani — Baobab private packages",
  "image": "ghcr.io/baobab-platform/baobab-dev:1.4.4",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "TZ": "Africa/Johannesburg",
    "NEXT_TELEMETRY_DISABLED": "1",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Thamani Next.js",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "visibility": "private",
    "onAutoForward": "silent"
  },
  "postCreateCommand": "node --version",
  "postStartCommand": "node scripts/codespaces/private-npm.mjs",
  "waitFor": "postCreateCommand",
  "customizations": {
    "codespaces": {
      "repositories": {
        "baobab-platform/baobab-dev": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "baobab-platform/shared": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      },
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.21.0"
    }
  }
}
