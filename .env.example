MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKET=za
NEXT_PUBLIC_DEFAULT_REGION_ID=

# IAM-N07: opt-in private human BFF and CP read-only logistics navigation.
# These placeholders are NOT credentials and do NOT authorize any deployment.
# Never set NODE_TLS_REJECT_UNAUTHORIZED=0; use private verified TLS trust roots.
THAMANI_OIDC_ENABLED=false
THAMANI_OIDC_ENVIRONMENT=development
THAMANI_OIDC_ORIGIN=https://thamani.example.invalid/
THAMANI_OIDC_ISSUER=https://iam.example.invalid/
THAMANI_OIDC_CLIENT_ID=
THAMANI_OIDC_CLIENT_SECRET=
THAMANI_OIDC_INTROSPECTION_ENDPOINT=https://iam.example.invalid/admin/oauth2/introspect
THAMANI_OIDC_CP_ORIGIN=https://cp.example.invalid/
THAMANI_OIDC_ID_TOKEN_ALGORITHM=RS256
THAMANI_OIDC_TRUST_PROXY=false

# The BFF refuses to issue sessions without private Redis TLS custody.
# A least-privilege Redis ACL must permit only thamani:bff:v1:<epoch>:*.
THAMANI_BFF_STORE_ENABLED=false
THAMANI_BFF_REDIS_HOST=
THAMANI_BFF_REDIS_PORT=6380
THAMANI_BFF_REDIS_USERNAME=
THAMANI_BFF_REDIS_PASSWORD=
THAMANI_BFF_REDIS_CA_PEM=
THAMANI_BFF_STORE_KEYS_JSON=
THAMANI_BFF_STORE_ACTIVE_KEY=
THAMANI_BFF_STORE_EPOCH=

# One owner-defined context per bounded deployment; no browser selector,
# inherited holding-company grant or automatically provisioned customer tenant.
THAMANI_LOGISTICS_CONTEXT_ENABLED=false
THAMANI_LOGISTICS_ORGANISATION_ID=
THAMANI_LOGISTICS_TENANT_ID=
THAMANI_LOGISTICS_COUNTRY_CODE=ZA
