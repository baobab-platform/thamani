{
  "name": "@baobab-platform/thamani",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:logistics:browser": "playwright test --config playwright.logistics.config.ts",
    "prototype:dev": "next dev prototype",
    "prototype:build": "next build prototype --webpack",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "test:e2e:visual": "playwright test e2e/landing-page.visual.spec.ts --project=chromium --workers=1",
    "test:e2e:a11y": "playwright test e2e/landing-page.accessibility.spec.ts --project=chromium --workers=1",
    "test:e2e:lighthouse": "THAMANI_LIGHTHOUSE_ONLY=true playwright test e2e/lighthouse.spec.ts --project=chromium --workers=1",
    "bxs:verify": "node --test scripts/verify-bxs-six.node.mjs"
  },
  "dependencies": {
    "@baobab-platform/experience-charts": "0.1.0",
    "@baobab-platform/experience-geo-core": "0.3.1",
    "@baobab-platform/experience-geo-deckgl": "0.1.0",
    "@baobab-platform/experience-geo-maplibre": "0.2.0",
    "@baobab-platform/experience-tokens": "0.3.1",
    "@baobab-platform/experience-ui": "0.3.1",
    "@base-ui/react": "1.9.0",
    "@medusajs/js-sdk": "2.22.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
